# Jellyfin connection
JELLYFIN_URL=http://localhost:8096
JELLYFIN_API_KEY=your_api_key_here
# Optional - leave blank to auto-detect first admin user
JELLYFIN_USER_ID=

# Destination directories
# SOURCE_DIR: Current messy TV directory
SOURCE_DIR=/TV
# KIDS_DEST: Where kids shows go
KIDS_DEST=/tv-kids
# ADULTS_DEST: Where adult shows go (can be same as source!)
ADULTS_DEST=/TV

# Database
ORGANIZER_DB=organizer.db

# Web UI
HOST=0.0.0.0
PORT=5000
DEBUG=false

# Flask secret key (change for production)
SECRET_KEY=change-me-in-production
