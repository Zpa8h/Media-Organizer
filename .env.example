# Jellyfin connection
JELLYFIN_URL=http://localhost:8096
JELLYFIN_API_KEY=your_api_key_here
JELLYFIN_USER_ID=             # Optional - auto-detects first admin user

# Destination directories
SOURCE_DIR=/TV                # Current messy TV directory
KIDS_DEST=/tv-kids            # Where kids shows go
ADULTS_DEST=/TV               # Where adult shows go (can be same as source!)

# Database
ORGANIZER_DB=organizer.db

# Web UI
HOST=0.0.0.0
PORT=5000
DEBUG=false

# Flask secret key (change for production)
SECRET_KEY=change-me-in-production
